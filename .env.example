# Supabase Client Configuration (Browser-Safe Anon Key Only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ==============================================================================
# Server-Side Secrets ONLY (Set in Supabase Edge Function Secrets & Netlify Env)
# NEVER prefix these with VITE_ or commit real values to source control.
# ==============================================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
LMS_PUBLIC_URL=https://lms.yourcompany.com
ORGANIZATION_NAME=Captain LMS

# Choose active provider: resend | smtp | m365 | google_workspace
EMAIL_PROVIDER=resend
LMS_FROM_EMAIL=Captain LMS <lms@yourcompany.com>

# Option 1: Resend
RESEND_API_KEY=
DIGEST_FROM=

# Option 2: Corporate SMTP Relay
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Option 3: Microsoft 365 (Graph API Client Credentials with Mail.Send)
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_SENDER_USER=

# Option 4: Google Workspace (Gmail API OAuth2 Refresh Token)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional AI Question Generation (Netlify/Server only)
GEMINI_API_KEY=
GEMINI_MODEL=